$var reg 8 B shift_reg [7:0] $end
$upscope $end
$scope module dut_rx $end
$var wire 1 C clk $end
$var wire 1 : rst_n $end
$var reg 8 D rx_data_o [7:0] $end
$var reg 1 E valid_o $end
$var reg 1 F error_o $end
$var wire 1 # rx_i $end
$var reg 2 G state $end
$var reg 2 H rx_sync [1:0] $end
$var reg 1 I rx_fall $end
$var reg 9 J cnt [8:0] $end
$var reg 3 K bit_cnt [2:0] $end
$var reg 8 L shift_reg [7:0] $end
$upscope $end
$upscope $end
$enddefinitions $end

