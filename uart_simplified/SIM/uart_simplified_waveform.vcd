$var reg 2 @ n_state $end
$var reg 5 A div_cnt [4:0] $end
$var reg 4 B phase [3:0] $end
$var reg 1 C phase_tick $end
$var reg 3 D bit_cnt [2:0] $end
$var reg 8 E shift_reg [7:0] $end
$upscope $end
$scope module dut_rx $end
$var wire 1 F clk $end
$var wire 1 : rst_n $end
$var reg 8 G rx_data_o [7:0] $end
$var reg 1 H valid_o $end
$var reg 1 I error_o $end
$var wire 1 # rx_i $end
$var reg 2 J c_state $end
$var reg 2 K n_state $end
$var reg 2 L rx_sync [1:0] $end
$var reg 1 M rx_fall $end
$var reg 5 N div_cnt [4:0] $end
$var reg 4 O phase [3:0] $end
$var reg 1 P phase_tick $end
$var reg 3 Q bit_cnt [2:0] $end
$var reg 8 R shift_reg [7:0] $end
$var reg 1 S valid_r $end
$var reg 1 T error_r $end
$upscope $end
$upscope $end
$enddefinitions $end

