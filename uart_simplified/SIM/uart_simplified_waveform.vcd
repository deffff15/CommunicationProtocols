$var reg 1 * busy $end
$var reg 8 + rx_data [7:0] $end
$var reg 1 , valid $end
$var reg 1 - error $end
$scope module mon_cb $end
$var reg 1 . rst_n $end
$var reg 1 / start $end
$var reg 8 0 data [7:0] $end
$var reg 1 1 sel $end
$var reg 1 2 rx_ext $end
