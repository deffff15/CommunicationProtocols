  1ps
$end

$scope module tb_uart $end
$var reg 1 ! clk $end
$var wire 1 " tx_w $end
$var wire 1 # rx_w $end
$scope module vif $end
$var wire 1 $ clk $end
$var wire 1 " tx $end
$var wire 1 # rx_line $end
$var reg 1 % rst_n $end
$var reg 1 & start $end
$var reg 8 ' data [7:0] $end
$var reg 1 ( sel $end
$var reg 1 ) rx_ext $end
$var reg 1 * busy $end
$var reg 8 + rx_data [7:0] $end
$var reg 1 , valid $end
$var reg 1 - error $end
$scope module mon_cb $end
$var reg 1 . rst_n $end
$var reg 1 / start $end
$var reg 8 0 data [7:0] $end
$var reg 1 1 sel $end
$var reg 1 2 rx_ext $end
$var reg 1 3 busy $end
$var reg 8 4 rx_data [7:0] $end
$var reg 1 5 valid $end
$var reg 1 6 error $end
$var reg 1 7 tx $end
$var reg 1 8 rx_line $end
$upscope $end
$upscope $end
$scope module dut_tx $end
$var wire 1 9 clk $end
$var wire 1 : rst_n $end
$var wire 1 ; start_i $end
$var wire 8 < data_i [7:0] $end
$var reg 1 = busy_o $end
$var reg 1 > tx_o $end
$var reg 2 ? c_state $end
$var reg 2 @ n_state $end
$var reg 5 A div_cnt [4:0] $end
$var reg 4 B phase [3:0] $end
$var reg 1 C phase_tick $end
$var reg 3 D bit_cnt [2:0] $end
$var reg 8 E shift_reg [7:0] $end
$var reg 1 F tx_r $end
$upscope $end
$scope module dut_rx $end
$var wire 1 G clk $end
$var wire 1 : rst_n $end
$var reg 8 H rx_data_o [7:0] $end
$var reg 1 I valid_o $end
$var reg 1 J error_o $end
$var wire 1 # rx_i $end
$var reg 2 K c_state $end
$var reg 2 L n_state $end
$var reg 2 M rx_sync [1:0] $end
$var reg 1 N rx_fall $end
$var reg 5 O div_cnt [4:0] $end
$var reg 4 P phase [3:0] $end
$var reg 1 Q phase_tick $end
$var reg 3 R bit_cnt [2:0] $end
$var reg 8 S shift_reg [7:0] $end
$var reg 1 T valid_r $end
$var reg 1 U error_r $end
$upscope $end
$upscope $end
$enddefinitions $end

