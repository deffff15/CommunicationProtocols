$scope module tb_i2c $end
$var reg 1 ! clk $end
$var tri1 1 " scl $end
$var tri1 1 # sda $end
$scope module vif $end
$var wire 1 $ clk $end
$var wire 1 " scl $end
$var wire 1 # sda $end
$var reg 1 % rst_n $end
$var reg 1 & start $end
$var reg 7 ' addr [6:0] $end
$var reg 8 ( data [7:0] $end
$var reg 1 ) busy $end
$var reg 1 * ack_error $end
$var reg 8 + rx_data [7:0] $end
$var reg 1 , valid $end
$scope module mon_cb $end
$var reg 1 - rst_n $end
$var reg 1 . start $end
$var reg 7 / addr [6:0] $end
$var reg 8 0 data [7:0] $end
$var reg 1 1 busy $end
$var reg 1 2 ack_error $end
$var reg 8 3 rx_data [7:0] $end
$var reg 1 4 valid $end
$var reg 1 5 scl $end
$var reg 1 6 sda $end
$upscope $end
$upscope $end
$scope module dut_master $end
$var wire 1 7 clk $end
$var wire 1 8 rst_n $end
$var wire 1 9 start_i $end
$var wire 7 : addr_i [6:0] $end
$var wire 8 ; data_i [7:0] $end
$var reg 1 < busy_o $end
$var reg 1 = ack_error_o $end
$var wire 1 " scl_io $end
$var wire 1 # sda_io $end
$var reg 4 > c_state $end
$var reg 4 ? n_state $end
$var reg 4 @ div_cnt [3:0] $end
$var reg 2 A phase [1:0] $end
$var reg 1 B phase_tick $end
$var reg 3 C bit_cnt [2:0] $end
$var reg 8 D shift_reg [7:0] $end
$var reg 1 E sda_drive_low $end
$var reg 1 F scl_drive_low $end
$var reg 1 G ack_err_r $end
$upscope $end
$scope module dut_slave $end
$var wire 1 H clk $end
$var wire 1 8 rst_n $end
$var reg 8 I rx_data_o [7:0] $end
$var reg 1 J valid_o $end
$var wire 1 " scl_io $end
$var wire 1 # sda_io $end
$var reg 3 K c_state $end
$var reg 3 L n_state $end
$var reg 2 M scl_sync [1:0] $end
$var reg 2 N sda_sync [1:0] $end
$var reg 1 O scl_rise $end
$var reg 1 P scl_fall $end
$var reg 1 Q sda_rise $end
$var reg 1 R sda_fall $end
$var reg 1 S start_cond $end
$var reg 1 T stop_cond $end
$var reg 3 U bit_cnt [2:0] $end
$var reg 8 V shift_reg [7:0] $end
$var reg 1 W sda_drive_low $end
$upscope $end
$upscope $end
$enddefinitions $end

